# PurpleGap auth + billing
# Copy to .env.local (never commit secrets).
#
# AUTH_MODE=clerk  → Clerk SSO is primary (requires keys below).
# AUTH_MODE=demo   → local purplegap_session cookie (email/password demo).
# If Clerk keys are missing, the app always falls back to demo — even when AUTH_MODE=clerk.

AUTH_MODE=clerk

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Enterprise API key for /api/v1/* (Bearer or X-API-Key). Never commit real keys.
# Demo pattern: pg_live_demo_enterprise_key — set a unique value in .env.local
PURPLEGAP_API_KEY=
